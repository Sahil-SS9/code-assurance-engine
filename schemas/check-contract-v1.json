{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckContract v1",
  "type": "object",
  "properties": {
    "schema": {"const": "check-contract-v1"},
    "goal": {"type": "string", "minLength": 4, "maxLength": 600},
    "assessed_areas": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 255},
      "minItems": 1,
      "maxItems": 200
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "check_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 200},
          "kind": {"enum": ["collect-only", "test-run", "static-tool", "other"]},
          "argv": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 512},
            "minItems": 1,
            "maxItems": 64
          },
          "cwd": {"type": "string", "minLength": 1, "maxLength": 512},
          "parser_id": {"anyOf": [{"type": "null"}, {"enum": ["junit-xml", "pytest-terminal"]}]},
          "expected_collection": {
            "anyOf": [
              {"type": "null"},
              {"type": "object", "properties": {"tests": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}}, "required": ["tests"], "additionalProperties": false}
            ]
          },
          "oracle": {
            "type": "object",
            "properties": {
              "allowed_failures": {"type": "integer", "minimum": 0},
              "description": {"anyOf": [{"type": "null"}, {"type": "string", "maxLength": 2000}]}
            },
            "additionalProperties": false
          },
          "executable": {"type": "boolean"}
        },
        "required": ["check_id", "label", "kind", "argv"],
        "additionalProperties": false
      }
    },
    "optional_checks": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "object"}
    },
    "negative_checks": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "object"}
    },
    "env_allowlist": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "network_enabled": {"type": "boolean"},
    "model_enabled": {"type": "boolean"},
    "supported_platforms": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["linux", "macos", "windows"]}
    },
    "timeouts": {
      "type": "object",
      "properties": {
        "per_check_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "total_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      },
      "additionalProperties": false
    },
    "proposed_by": {"enum": ["review", "human", "model", "automation"]},
    "created_at": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 4, "maxLength": 40}]},
    "contract_id": {"type": "string", "format": "sha256-hex"}
  },
  "required": ["schema", "goal", "assessed_areas", "required_checks", "network_enabled", "model_enabled", "supported_platforms", "env_allowlist"],
  "additionalProperties": false
}
